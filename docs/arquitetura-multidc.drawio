        <mxCell id="n41" value="dentro do DC: IP do pod&lt;br&gt;(prefer_local = true)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=2;strokeColor=#82B366;endArrow=classic;startArrow=classic;fontSize=11;fontColor=#2E6B34;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n10" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n42" value="VNet peering global&lt;br&gt;porta 7000 entre os nós:&lt;br&gt;gossip  +  replicação de dados" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeWidth=3;strokeColor=#D79B00;endArrow=classic;startArrow=classic;fontSize=12;fontStyle=1;fontColor=#7A4F00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n15" target="n33"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n43" value="AS QUATRO FAIXAS DE ENDEREÇO&lt;br&gt;    10.10.0.0/20  ·  10.20.0.0/20      as VMs dos clusters — roteáveis entre as regiões pelo peering&lt;br&gt;    10.10.32.0/24 ·  10.20.32.0/24     as caixas postais (internal LB) — IP fixo por nó, é o broadcast_address&lt;br&gt;    10.244.0.0/16                      os pods — interna a cada cluster e IDÊNTICA nas duas regiões, por isso não serve entre elas&lt;br&gt;    10.0.0.0/16                        os Services (ClusterIP) — interna a cada cluster&lt;br&gt;&lt;br&gt;CADA NÓ TEM DOIS ENDEREÇOS&lt;br&gt;    escuta (listen_address) no IP do pod — único endereço que a máquina realmente possui&lt;br&gt;    anuncia (broadcast_address) o IP da caixa postal — único endereço que os outros conseguem alcançar&lt;br&gt;    prefer_local = true faz vizinho do mesmo DC falar direto pelo IP do pod; só a travessia entre regiões usa a caixa postal&lt;br&gt;&lt;br&gt;POR QUE ISSO TOLERA FALHA&lt;br&gt;    RF {dc1: 3, dc2: 3} → cada linha existe 6 vezes.  LOCAL_QUORUM confirma com 2 das 3 réplicas LOCAIS, sem esperar a outra região.&lt;br&gt;    Cai um nó → restam 2 de 3.      Cai um rack/zona → réplicas espalhadas entre racks.      Cai uma região → a outra nunca dependeu dela." style="rounded=1;html=1;fillColor=#FAFAFA;strokeColor=#CFD8DC;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;fontSize=12;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1620" height="232" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
